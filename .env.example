# Signaling server URL (client). Dev default: http://localhost:3001
VITE_SERVER_URL=http://localhost:3001

# TURN (optional). Comma-separated URLs; leave empty to use STUN + free Open Relay.
# e.g. turn:turn.example.com:443,turn:turn.example.com:443?transport=tcp
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Firebase web config (falls back to the linked vuga-464e5 project if unset)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Signaling server (read by server/index.js via dotenv)
PORT=3001
CLIENT_ORIGIN=*
